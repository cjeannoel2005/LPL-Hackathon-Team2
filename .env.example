# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

# OpenSearch (update after CloudFormation deployment)
OPENSEARCH_ENDPOINT=your-endpoint.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX_NAME=documents

# Bedrock Models
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 Bucket (update after deployment)
S3_BUCKET_NAME=lpl-ai-assistant-docs
